# Copy to .env.local for local development. Never commit .env.local.
# Server-only (read in src/env.server.ts; never reaches the browser):
# Free key at https://openrouter.ai/keys; enables "Tailor with AI".
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
SERVICE_VERSION=dev
# Public (read in src/env.ts; inlined into the client bundle at build time, so never a secret):
NEXT_PUBLIC_APP_NAME=SwaraMatch
